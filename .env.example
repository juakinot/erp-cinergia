# ERP CINERGIA — plantilla de variables de entorno
#
# Copia este archivo a `.env` y llena los valores reales.
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.
# Si una credencial se filtra por accidente, rótala en Supabase de inmediato:
# borrar el commit no basta, queda en el historial de git.

# ─────────────────────────────────────────────────────────
# BASE DE DATOS (Supabase → Project Settings → Database)
# ─────────────────────────────────────────────────────────

# Pooler, puerto 6543. La usa la aplicación en runtime.
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa, puerto 5432. La usan las migraciones.
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────
# SUPABASE AUTH (Supabase → Project Settings → API)
# ─────────────────────────────────────────────────────────

# Estas dos viajan al navegador. Son públicas por diseño: quien las tenga
# solo puede hacer lo que las políticas RLS permitan a un usuario anónimo.
NEXT_PUBLIC_SUPABASE_URL="https://PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Esta NO viaja al navegador nunca. Se salta todas las políticas RLS.
# Úsala solo en jobs de servidor (crons, seeds). Tratarla como una contraseña.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─────────────────────────────────────────────────────────
# CORREO TRANSACCIONAL (Resend)
# ─────────────────────────────────────────────────────────

RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="ERP CINERGIA <no-responder@tu-dominio.pe>"

# ─────────────────────────────────────────────────────────
# IA PARA ACTAS (Anthropic) — Fase 2
# ─────────────────────────────────────────────────────────

ANTHROPIC_API_KEY="sk-ant-..."

# ─────────────────────────────────────────────────────────
# WHATSAPP (Meta Cloud API) — Fase 3
# ─────────────────────────────────────────────────────────

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ─────────────────────────────────────────────────────────
# APLICACIÓN
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=""
